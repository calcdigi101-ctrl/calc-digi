# Copy to .env.local for local development; set the same keys in Vercel → Settings → Environment Variables.

# Server-only. Used by app/api/ai/route.ts to proxy the AI assistant. Never expose it client-side
# (do NOT prefix it with NEXT_PUBLIC_).
ANTHROPIC_API_KEY=

# Contact form (app/pages/contact). Sends through Resend (https://resend.com). If unset, the form
# reports that messages can't be sent right now.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional: Supabase-hosted blog articles (merged with the built-in articles in lib/articles.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
