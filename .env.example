# Copy to .env.local for local development; set the same keys in Vercel → Settings → Environment Variables.

# AI Assistant Providers (Pick ANY ONE or use built-in fallback):
# 1. Groq (Recommended: 100% Free Open Models: Llama 3.3 70B, Llama 3.1 8B): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 2. OpenRouter (Free Open Source Models pool): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 3. Google Gemini (Free Gemini 1.5/2.0 Flash): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 4. Anthropic Claude (Optional):
ANTHROPIC_API_KEY=

# Contact form (app/pages/contact). Sends through Resend (https://resend.com).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional: Supabase-hosted blog articles (merged with the built-in articles in lib/articles.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
